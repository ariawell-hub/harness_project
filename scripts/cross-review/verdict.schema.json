{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "risk", "summary", "findings"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approve", "request_changes"] },
    "risk": { "type": "string", "enum": ["low", "normal", "high"] },
    "summary": { "type": "string", "maxLength": 1000 },
    "findings": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "title", "evidence", "suggestion"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "file": { "type": "string", "maxLength": 300 },
          "line": { "type": "integer", "minimum": 0 },
          "title": { "type": "string", "maxLength": 200 },
          "evidence": { "type": "string", "maxLength": 1500 },
          "suggestion": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
