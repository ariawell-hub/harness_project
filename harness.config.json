{
  "version": 1,
  "stage": "build",
  "profile": "core",
  "profileVersion": "core@0.1.0",
  "github": {
    "remote": "origin",
    "defaultBranch": "main",
    "owner": "ariawell-hub",
    "bot": "ariawell247",
    "collaborators": [],
    "priorityLabels": ["priority:high", "priority:medium", "priority:low"],
    "needsHumanLabel": "needs-human"
  },
  "paths": {
    "worktreeRoot": "../{repo}.worktrees",
    "devEnvFile": "~/.config/harness/{repo}/.env.dev"
  },
  "limits": {
    "sessionTimeoutMin": 30,
    "acTimeoutSec": 900,
    "stepFailedCheckLimit": 10,
    "stepSessionMinutesLimit": 120,
    "runnerMaxHours": 12,
    "workers": 1,
    "wipPerWorker": 2,
    "claimExpiryHours": 24,
    "usageLimitMaxWaitMin": 180,
    "pollSec": 120
  },
  "failure": {
    "switchAt": 3,
    "stopAt": 5
  },
  "commands": {
    "setup": {
      "run": "pnpm install --frozen-lockfile",
      "timeoutSec": 600
    },
    "fmt": {
      "run": "pnpm exec prettier --write .",
      "check": "pnpm exec prettier --check .",
      "timeoutSec": 300
    },
    "lint": {
      "run": "pnpm exec tsc -p tsconfig.json",
      "timeoutSec": 300
    },
    "test": {
      "run": "node --test \"scripts/test/*.test.ts\"",
      "timeoutSec": 900
    },
    "build": null,
    "dev": null,
    "verify": null
  },
  "docLint": {
    "agentsMdMaxLines": 120,
    "exclude": ["docs/harness/background/**", "docs/references/**", "docs/generated/**"]
  },
  "bypass": {
    "extraPatterns": [],
    "excludeExtensions": [".md"]
  },
  "guard": {
    "dbPatterns": [],
    "dbClients": []
  },
  "planReview": {
    "required": false
  },
  "riskPaths": [
    {
      "glob": "docs/**",
      "risk": "low"
    },
    {
      "glob": "scripts/**",
      "risk": "normal"
    },
    {
      "glob": "pnpm-lock.yaml",
      "risk": "normal"
    }
  ],
  "protectedPaths": [
    "scripts/**",
    ".github/**",
    ".claude/**",
    ".codex/**",
    "CODEOWNERS",
    ".gitignore",
    ".gitattributes",
    "docs/harness/**",
    ".mcp.json",
    ".githooks/**",
    ".devcontainer/**",
    ".vscode/**",
    "Makefile",
    "justfile",
    "package.json",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig.json",
    ".prettierrc",
    "harness.config.json",
    "profiles/**",
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "docs/core-beliefs.md",
    "docs/SECURITY.md",
    "docs/exec-plans/TEMPLATE*.md"
  ],
  "agents": {
    "claude": {
      "cmd": "claude",
      "args": [
        "-p",
        "--output-format",
        "json",
        "--permission-mode",
        "dontAsk",
        "--setting-sources",
        "user",
        "--strict-mcp-config"
      ],
      "permissionProfile": ".claude/runner-settings.json"
    },
    "codex": {
      "cmd": "codex",
      "args": [
        "exec",
        "--sandbox",
        "workspace-write",
        "--ephemeral",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "features.memories=false"
      ]
    }
  }
}
