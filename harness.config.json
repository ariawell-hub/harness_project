{
  "version": 1,
  "stage": "build",
  "profile": "core",
  "profileVersion": "core@0.1.0",
  "github": {
    "remote": "origin",
    "defaultBranch": "main",
    "owner": "ariawell-hub",
    "bot": "ariawell247",
    "collaborators": [],
    "botIssues": "exclude",
    "priorityLabels": ["priority:high", "priority:medium", "priority:low"],
    "needsHumanLabel": "needs-human"
  },
  "paths": {
    "worktreeRoot": "../{repo}.worktrees",
    "devEnvFile": "~/.config/harness/{repo}/.env.dev"
  },
  "limits": {
    "sessionTimeoutMin": 30,
    "acTimeoutSec": 900,
    "stepFailedCheckLimit": 10,
    "stepSessionMinutesLimit": 120,
    "runnerMaxHours": 12,
    "workers": 2,
    "wipPerWorker": 2,
    "claimExpiryHours": 24,
    "usageLimitMaxWaitMin": 180,
    "pollSec": 120,
    "ciStallHours": 24
  },
  "failure": {
    "switchAt": 3,
    "stopAt": 5
  },
  "commands": {
    "setup": {
      "run": "pnpm install --frozen-lockfile",
      "timeoutSec": 600
    },
    "fmt": {
      "run": "pnpm exec prettier --write .",
      "check": "pnpm exec prettier --check .",
      "timeoutSec": 300
    },
    "lint": {
      "run": "pnpm exec tsc -p tsconfig.json",
      "timeoutSec": 300
    },
    "test": {
      "run": "node --test --test-concurrency=$(node -p \"Math.max(2,Math.min(8,require('os').availableParallelism()-1))\") \"scripts/test/*.test.ts\"",
      "timeoutSec": 1800
    },
    "build": null,
    "dev": null,
    "verify": null
  },
  "docLint": {
    "agentsMdMaxLines": 120,
    "exclude": ["docs/harness/background/**", "docs/references/**", "docs/generated/**"]
  },
  "bypass": {
    "extraPatterns": [],
    "excludeExtensions": [".md"]
  },
  "guard": {
    "dbPatterns": [],
    "dbClients": [],
    "mcp": {
      "denyWords": ["delete", "trash", "remove", "destroy", "purge", "erase", "wipe", "cancel"],
      "denyTools": ["mcp__*Gmail__send_message", "mcp__*Gmail__reply", "mcp__*Gmail__forward"],
      "allowTools": [],
      "browserTools": [
        "mcp__claude-in-chrome__*",
        "mcp__playwright__*",
        "mcp__*Browser__*",
        "mcp__computer-use__*",
        "mcp__remote-devices__*"
      ],
      "denyHosts": ["github.com", "*.github.com", "github.dev", "*.github.dev"]
    }
  },
  "testEffect": {
    "files": ["scripts/test/*.test.ts"],
    "support": ["scripts/test/helpers.ts"],
    "command": ["node", "--test"],
    "timeoutSec": 900,
    "link": ["node_modules"],
    "assertPattern": "AssertionError|ERR_ASSERTION"
  },
  "planReview": {
    "required": true
  },
  "riskPaths": [
    {
      "glob": "docs/**",
      "risk": "low"
    },
    {
      "glob": "scripts/**",
      "risk": "normal"
    },
    {
      "glob": "pnpm-lock.yaml",
      "risk": "normal"
    }
  ],
  "protectedPaths": [
    "scripts/**",
    ".github/**",
    ".claude/**",
    ".codex/**",
    "CODEOWNERS",
    ".gitignore",
    ".gitattributes",
    "docs/harness/**",
    ".mcp.json",
    ".githooks/**",
    ".devcontainer/**",
    ".vscode/**",
    "Makefile",
    "justfile",
    "package.json",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig.json",
    ".prettierrc",
    "harness.config.json",
    "profiles/**",
    "AGENTS.md",
    "CLAUDE.md",
    "ARCHITECTURE.md",
    "docs/core-beliefs.md",
    "docs/SECURITY.md",
    "docs/exec-plans/TEMPLATE*.md"
  ],
  "ci": {
    "environments": ["judge-claude", "judge-codex", "codex-auth-store", "recorder", "revert"],
    "requiredChecks": [
      { "context": "check", "source": "actions" },
      { "context": "revert-check", "source": "recorder" },
      { "context": "plan-gate", "source": "recorder" },
      { "context": "risk-gate", "source": "recorder" },
      { "context": "deps-guard", "source": "recorder" },
      { "context": "harness-guard", "source": "recorder" },
      { "context": "review/claude", "source": "recorder" },
      { "context": "review/codex", "source": "recorder" },
      { "context": "review-ledger", "source": "recorder" }
    ],
    "recorderAppId": 5764201,
    "recorderBot": "harness-recorder[bot]",
    "repro": {
      "dir": "scripts/test",
      "command": ["node", "--test"],
      "failPattern": "AssertionError|ERR_ASSERTION",
      "timeoutSec": 120
    }
  },
  "deps": {
    "lockfiles": ["pnpm-lock.yaml"],
    "minReleaseAgeDays": 14,
    "licenses": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "0BSD", "ISC"],
    "registry": "https://registry.npmjs.org",
    "osvApi": "https://api.osv.dev/v1/querybatch"
  },
  "agents": {
    "claude": {
      "cmd": "claude",
      "args": [
        "-p",
        "--output-format",
        "json",
        "--permission-mode",
        "dontAsk",
        "--setting-sources",
        "user",
        "--strict-mcp-config"
      ],
      "permissionProfile": ".claude/runner-settings.json"
    },
    "codex": {
      "cmd": "codex",
      "args": [
        "exec",
        "--sandbox",
        "workspace-write",
        "--ephemeral",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "features.memories=false"
      ]
    }
  }
}
