{
  "name": "core",
  "version": "0.1.0",
  "description": "하네스 템플릿 자신(TypeScript 스크립트)을 개발할 때의 프로파일",
  "config": {
    "commands": {
      "setup": { "run": "pnpm install --frozen-lockfile", "timeoutSec": 600 },
      "fmt": {
        "run": "pnpm exec prettier --write .",
        "check": "pnpm exec prettier --check .",
        "timeoutSec": 300
      },
      "lint": { "run": "pnpm exec tsc -p tsconfig.json", "timeoutSec": 300 },
      "test": {
        "run": "node --test --test-concurrency=$(node -p \"Math.max(1,Math.min(8,require('os').availableParallelism()-1))\") \"scripts/test/*.test.ts\"",
        "timeoutSec": 1800
      },
      "build": null,
      "dev": null,
      "verify": null
    },
    "riskPaths": [
      { "glob": "docs/**", "risk": "low" },
      { "glob": "scripts/**", "risk": "normal" },
      { "glob": "pnpm-lock.yaml", "risk": "normal" }
    ],
    "guard": {
      "dbPatterns": [],
      "dbClients": [],
      "mcp": {
        "denyWords": ["delete", "trash", "remove", "destroy", "purge", "erase", "wipe", "cancel"],
        "denyTools": ["mcp__*Gmail__send_message", "mcp__*Gmail__reply", "mcp__*Gmail__forward"],
        "allowTools": [],
        "browserTools": [
          "mcp__claude-in-chrome__*",
          "mcp__playwright__*",
          "mcp__*Browser__*",
          "mcp__computer-use__*",
          "mcp__remote-devices__*"
        ],
        "denyHosts": ["github.com", "*.github.com", "github.dev", "*.github.dev"]
      }
    },
    "bypass": { "extraPatterns": [], "excludeExtensions": [".md"] }
  },
  "templates": []
}
