diff --git a/scripts/lib/changes.ts b/scripts/lib/changes.ts
new file mode 100644
index 0000000..1042c59
--- /dev/null
+++ b/scripts/lib/changes.ts
@@ -0,0 +1,101 @@
+// 변경 조각(TD-39, Issue #222). 보호 경로를 바꾼 PR은 CHANGELOG 끝과 설계서 머리말·변경 이력 끝에 줄을 더하지 않고
+// 계획마다 파일 하나(`docs/harness/changes/<계획 id>.md`)에 적는다. 계획이 다르면 파일이 달라 PR끼리 충돌하지 않는다.
+// 버전 번호를 매겨 CHANGELOG와 설계서로 옮기는 일은 모으기(`changes-collect`)가 한다.
+
+/** 조각 파일을 두는 폴더(리포 루트 기준, `/` 구분) */
+export const CHANGES_DIR = 'docs/harness/changes';
+/** 조각 파일 이름: 계획 id(`YYYYMMDD-소문자-이름`) + `.md` */
+const NAME_RE = /^(\d{8}-[a-z0-9]+(?:-[a-z0-9]+)*)\.md$/;
+const SECTIONS = ['CHANGELOG', '설계서 변경 이력'] as const;
+/** 항목 글이 버전으로 시작하면 안 된다(버전은 모으기가 매긴다) */
+const VERSIONED = /^v\d+(?:\.\d+)+\b/;
+
+export interface Fragment {
+  /** 계획 id(파일 이름) */
+  id: string;
+  /** CHANGELOG "다음 버전"에 옮길 항목(앞의 `- ` 뺀 글). 하나 이상 */
+  changelog: string[];
+  /** 설계서 변경 이력에 옮길 항목(앞의 `- ` 뺀 글). 없어도 된다 */
+  design: string[];
+}
+
+export type FragmentParse = { ok: true; value: Fragment } | { ok: false; problems: string[] };
+
+/** 리포 루트 기준 경로가 조각 파일 자리인가(`docs/harness/changes/<계획 id>.md`) */
+export function isFragmentPath(rel: string): boolean {
+  const slash = rel.lastIndexOf('/');
+  return rel.slice(0, slash) === CHANGES_DIR && NAME_RE.test(rel.slice(slash + 1));
+}
+
+/**
+ * 조각 파일을 읽는다. 형식:
+ *
+ * ```markdown
+ * # 변경 조각: <계획 id>
+ *
+ * ## CHANGELOG
+ *
+ * - <한 줄>
+ *
+ * ## 설계서 변경 이력
+ *
+ * - <한 줄>
+ * ```
+ *
+ * - 첫 줄의 계획 id는 파일 이름과 같다. 섹션은 이 둘뿐이고 이 차례다. `설계서 변경 이력`은 없어도 된다.
+ * - 섹션 안에는 빈 줄과 `- `로 시작하는 한 줄 항목만 둔다(이어지는 줄을 받지 않는다). CHANGELOG 항목은 하나 이상이다.
+ * - 항목 글은 버전(`v0.7.1`)으로 시작하지 않는다. 버전과 날짜는 모으기가 붙인다
+ */
+export function parseFragment(rel: string, text: string): FragmentParse {
+  const problems: string[] = [];
+  const name = /[^/]*$/.exec(rel)?.[0] ?? '';
+  const m = NAME_RE.exec(name);
+  if (!isFragmentPath(rel) || !m)
+    return {
+      ok: false,
+      problems: [`조각 파일의 자리·이름이 틀리다(${CHANGES_DIR}/<계획 id>.md): ${rel}`],
+    };
+  const id = m[1];
+  const lines = text.replace(/\r\n/g, '\n').replace(/\n$/, '').split('\n');
+  if (lines[0] !== `# 변경 조각: ${id}`) problems.push(`첫 줄은 \`# 변경 조각: ${id}\`이어야 한다`);
+  const items: Record<(typeof SECTIONS)[number], string[]> = {
+    CHANGELOG: [],
+    '설계서 변경 이력': [],
+  };
+  let section: (typeof SECTIONS)[number] | null = null;
+  const seen: string[] = [];
+  for (let i = 1; i < lines.length; i++) {
+    const l = lines[i];
+    const at = `${i + 1}번째 줄`;
+    if (l.trim() === '') continue;
+    const h = /^## (.+)$/.exec(l);
+    if (h) {
+      const s = SECTIONS.find((x) => x === h[1]);
+      if (!s) {
+        problems.push(`${at}: 받지 않는 섹션이다(${SECTIONS.join(', ')}만 둔다)`);
+        section = null;
+      } else if (seen.includes(s) || seen.length > SECTIONS.indexOf(s)) {
+        problems.push(`${at}: 섹션은 ${SECTIONS.join(', ')} 차례로 한 번씩 둔다`);
+        section = null;
+      } else {
+        seen.push(s);
+        section = s;
+      }
+      continue;
+    }
+    const item = /^- (.*)$/.exec(l);
+    if (!item || section === null) {
+      problems.push(`${at}: 섹션 안의 \`- \` 한 줄 항목과 빈 줄만 둔다`);
+      continue;
+    }
+    const body = item[1].trim();
+    if (body === '') problems.push(`${at}: 항목이 비었다`);
+    else if (VERSIONED.test(body))
+      problems.push(`${at}: 항목을 버전으로 시작하지 마라(버전과 날짜는 모으기가 붙인다)`);
+    else items[section].push(body);
+  }
+  if (items.CHANGELOG.length === 0)
+    problems.push('`## CHANGELOG` 섹션에 항목이 하나 이상 있어야 한다');
+  if (problems.length > 0) return { ok: false, problems };
+  return { ok: true, value: { id, changelog: items.CHANGELOG, design: items['설계서 변경 이력'] } };
+}
diff --git a/scripts/test/changes.test.ts b/scripts/test/changes.test.ts
new file mode 100644
index 0000000..2947e8e
--- /dev/null
+++ b/scripts/test/changes.test.ts
@@ -0,0 +1,153 @@
+// 변경 조각(TD-39, Issue #222): 조각 파일의 형식, doc-lint의 검사, 두 계획의 조각이 충돌하지 않는 것을 본다.
+// 계획 20261123-change-fragments step0.
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import { test } from 'node:test';
+import { docLint } from '../gates/doc-lint.ts';
+import { loadConfig } from '../lib/config.ts';
+import { runSync } from '../lib/exec.ts';
+import { commitAll, fixtureConfig, gitInit, sh, tmp, write } from './helpers.ts';
+
+// 새 모듈은 동적으로 가져온다: 이 변경 전의 코드에는 없어서, 정적으로 가져오면 파일 전체가 단언 전에 죽는다
+const changes: Partial<typeof import('../lib/changes.ts')> =
+  await import('../lib/changes.ts').catch(() => ({}));
+const ID = '20261123-demo';
+const FILE = `docs/harness/changes/${ID}.md`;
+const FRAG = (body: string, id = ID) => `# 변경 조각: ${id}\n${body}`;
+const OK = FRAG('\n## CHANGELOG\n\n- 한 줄\n- 두 줄\n\n## 설계서 변경 이력\n\n- 10.4절에 적었다\n');
+
+/** 결과를 값으로: 통과면 항목, 아니면 문제 목록. 이 변경 전의 코드에서도 단언으로 실패하게 한다 */
+function parsed(rel: string, text: string): unknown {
+  const parse = changes.parseFragment;
+  if (typeof parse !== 'function') return 'parseFragment 없음';
+  const r = parse(rel, text);
+  return r.ok ? r.value : r.problems;
+}
+
+test('조각 파일의 자리: docs/harness/changes/<계획 id>.md만이다', () => {
+  assert.equal(changes.CHANGES_DIR, 'docs/harness/changes');
+  const at = changes.isFragmentPath;
+  assert.equal(typeof at, 'function');
+  for (const ok of [
+    FILE,
+    'docs/harness/changes/20261123-a.md',
+    'docs/harness/changes/20261123-a-b-2.md',
+  ])
+    assert.equal(at!(ok), true, ok);
+  for (const no of [
+    'docs/harness/changes/README.md',
+    'docs/harness/changes/2026-11-23-a.md',
+    'docs/harness/changes/20261123-A.md',
+    'docs/harness/changes/20261123-a.txt',
+    'docs/harness/changes/sub/20261123-a.md',
+    'docs/harness/20261123-a.md',
+    'x/docs/harness/changes/20261123-a.md',
+  ])
+    assert.equal(at!(no), false, no);
+});
+
+test('조각 파일을 읽는다: CHANGELOG 항목은 하나 이상, 설계서 변경 이력은 없어도 된다', () => {
+  assert.deepEqual(parsed(FILE, OK), {
+    id: ID,
+    changelog: ['한 줄', '두 줄'],
+    design: ['10.4절에 적었다'],
+  });
+  assert.deepEqual(parsed(FILE, FRAG('\n## CHANGELOG\n\n- 하나\n')), {
+    id: ID,
+    changelog: ['하나'],
+    design: [],
+  });
+  // CRLF도 같다
+  assert.deepEqual(parsed(FILE, OK.replace(/\n/g, '\r\n')), parsed(FILE, OK));
+});
+
+test('조각 파일의 형식이 틀리면 줄마다 문제를 낸다', () => {
+  const problems = (text: string, rel = FILE) => {
+    const r = parsed(rel, text);
+    assert.ok(Array.isArray(r), JSON.stringify(r));
+    return (r as string[]).join('\n');
+  };
+  assert.match(problems(OK, 'docs/harness/changes/README.md'), /자리·이름/);
+  assert.match(problems(OK.replace(`# 변경 조각: ${ID}`, '# 변경 조각: 20261123-other')), /첫 줄/);
+  assert.match(problems(FRAG('\n## 설계서 변경 이력\n\n- 하나\n')), /CHANGELOG.*하나 이상/);
+  assert.match(problems(FRAG('\n## CHANGELOG\n\n')), /CHANGELOG.*하나 이상/);
+  assert.match(problems(FRAG('\n## CHANGELOG\n\n- 하나\n\n## 기타\n\n- 둘\n')), /받지 않는 섹션/);
+  assert.match(
+    problems(FRAG('\n## 설계서 변경 이력\n\n- 하나\n\n## CHANGELOG\n\n- 둘\n')),
+    /차례로 한 번씩/,
+  );
+  assert.match(
+    problems(FRAG('\n## CHANGELOG\n\n- 하나\n\n## CHANGELOG\n\n- 둘\n')),
+    /차례로 한 번씩/,
+  );
+  assert.match(problems(FRAG('\n## CHANGELOG\n\n- 하나\n  이어지는 줄\n')), /3번째 줄|6번째 줄/);
+  assert.match(problems(FRAG('\n머리 글\n\n## CHANGELOG\n\n- 하나\n')), /3번째 줄/);
+  assert.match(problems(FRAG('\n## CHANGELOG\n\n- \n- 하나\n')), /비었다/);
+  assert.match(problems(FRAG('\n## CHANGELOG\n\n- v0.7.81 (2026-11-23): 하나\n')), /버전으로 시작/);
+});
+
+/** 설정·지도·색인만 둔 리포(doc-lint용) */
+function lintRepo(): string {
+  const root = path.join(tmp(), 'r');
+  gitInit(root);
+  write(
+    root,
+    'harness.config.json',
+    JSON.stringify(fixtureConfig({ docLint: { agentsMdMaxLines: 10, exclude: [] } })),
+  );
+  write(root, 'AGENTS.md', '# 지도\n\n- [목차](docs/index.md)\n');
+  write(
+    root,
+    'docs/index.md',
+    '---\nstatus: active\nrelated_code: []\nreview_cycle: on-change\n---\n# 목차\n',
+  );
+  return root;
+}
+const lint = (root: string) =>
+  docLint(root, loadConfig(root), { noHistory: true }).errors.map((e) => `${e.rule} ${e.what}`);
+
+test('doc-lint: 조각 파일은 frontmatter·색인을 요구하지 않고 형식을 본다(R8 변경 조각)', () => {
+  const root = lintRepo();
+  write(root, FILE, OK);
+  assert.deepEqual(lint(root), []);
+  write(root, FILE, FRAG('\n## CHANGELOG\n\n'));
+  assert.deepEqual(lint(root), [
+    `R8 변경 조각 ${FILE}: \`## CHANGELOG\` 섹션에 항목이 하나 이상 있어야 한다`,
+  ]);
+  // 폴더 안의 다른 이름도 잡는다
+  write(root, FILE, OK);
+  write(root, 'docs/harness/changes/notes.md', '# 메모\n');
+  assert.match(
+    lint(root).join('\n'),
+    /^R8 변경 조각 docs\/harness\/changes\/notes\.md: 조각 파일의 자리·이름/,
+  );
+});
+
+test('두 계획이 각자 조각 파일만 더하면 서로 병합해도 충돌하지 않는다', () => {
+  const root = path.join(tmp(), 'm');
+  gitInit(root);
+  write(root, 'docs/harness/CHANGELOG.md', '# 이력\n\n## 다음 버전 (미배포)\n\n- 앞 항목\n');
+  commitAll(root, 'init');
+  const main = sh('git', ['rev-parse', '--abbrev-ref', 'HEAD'], root);
+  for (const id of ['20261123-a', '20261123-b']) {
+    sh('git', ['checkout', '-q', '-b', id, main], root);
+    write(root, `docs/harness/changes/${id}.md`, FRAG('\n## CHANGELOG\n\n- 바꿈\n', id));
+    commitAll(root, id);
+  }
+  sh('git', ['checkout', '-q', main], root);
+  sh('git', ['merge', '-q', '--no-edit', '20261123-a'], root);
+  const r = runSync('git', ['merge', '--no-edit', '20261123-b'], { cwd: root });
+  assert.equal(r.code, 0, r.stdout + r.stderr);
+  for (const id of ['20261123-a', '20261123-b'])
+    assert.deepEqual(
+      parsed(
+        `docs/harness/changes/${id}.md`,
+        sh('git', ['show', `HEAD:docs/harness/changes/${id}.md`], root) + '\n',
+      ),
+      {
+        id,
+        changelog: ['바꿈'],
+        design: [],
+      },
+    );
+});
